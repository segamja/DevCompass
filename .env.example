# Supabase — 시그널수사 프로젝트와 동일 DB 공유 (injwreiavyulvueqrbbk)
# 시그널수사: js/config.js 에 URL/anon key 저장 (.env 없음)
# DevCompass: .env.local 사용

VITE_SUPABASE_URL=https://injwreiavyulvueqrbbk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-signal-config-or-dashboard

# Supabase Service Role (필수 — API 서버 / GitHub sync)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (선택 — AI 분석, 없으면 fallback 데이터 사용)
OPENAI_API_KEY=sk-your-openai-key

# GitHub OAuth App은 Supabase Dashboard > Authentication > Providers > GitHub 에서 설정
# Callback URL: https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
# 상세 가이드: docs/GITHUB_AUTH_SETUP.md

# 로컬 API 서버 포트
PORT=3001
